# Copy to .env and fill in. .env never enters git.
# Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Root log level for the Django side (rag/ CLIs configure their own): DEBUG/INFO/WARNING.
DJANGO_LOG_LEVEL=INFO

# Generation endpoint: vLLM on the MICC server behind an SSH tunnel
# (ssh -L 8000:localhost:8000 <server>). vLLM ignores the API key but the
# OpenAI client requires one. Defaults below match config/env.py.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=unused
VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
