# Copy to .env and fill in. .env never enters git.
# Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Root log level for the Django side (rag/ CLIs configure their own): DEBUG/INFO/WARNING.
DJANGO_LOG_LEVEL=INFO

# PostgreSQL, served by docker-compose.yml — compose reads this same file, so
# these values configure both the container and Django. Only the password has
# no default: pick anything for local work, but pick it yourself.
DJANGO_DB_NAME=mca
DJANGO_DB_USER=mca
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432

# Turn on only where something actually terminates TLS. It gates the HTTPS
# redirect, HSTS and secure cookies together; on a plain-HTTP demo host it would
# make the site unreachable.
DJANGO_BEHIND_TLS=false

# Generation endpoint: any OpenAI-compatible server. Default: local Ollama
# (`ollama pull qwen3:4b-instruct-2507-q4_K_M`). Ollama and vLLM both ignore
# the API key but the OpenAI client requires one. Defaults match config/env.py.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=unused
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# M3 experiments — MICC vLLM behind an SSH tunnel (ssh -L 8000:localhost:8000 <server>):
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
