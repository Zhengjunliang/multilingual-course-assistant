// No JSX element carries a `title` attribute (DESIGN.md, "Components"): the
// browser's hint opens for a resting mouse alone, never for keyboard focus or
// a touch, and screen readers announce it inconsistently. A hint is a
// `Tooltip` (src/components/ui/tooltip.tsx). GritQL cannot tell a DOM element
// from a component, so a component's own prop is named `heading`, never
// `title`; an element that truly needs the attribute, such as an iframe's
// accessible name, carries `biome-ignore lint/plugin: <why>`.
// The JSX attribute node itself, not a `title=` snippet: a snippet also
// matches `let title = "…"`, an assignment or a parameter's default.
// src/test/no-title-attribute.test.ts holds this pattern to every spelling of
// the attribute and to none of those.
language js

JsxAttribute(name = $name) as $attribute where {
  $name <: `title`,
  register_diagnostic(
    span=$attribute,
    message="No title attribute: a hint is a Tooltip, and what it says belongs in the visible text or the accessible name too.",
    severity="error"
  )
}
